# ---------------------------------------------------------------------------
# SLUCM smoke test.
#
# A 10 x 10 x 20 synthetic real-data domain (dx = dy = 1 km, dz = 100 m) with a
# 4 x 4 block of urban cells in the middle, generated by
# Tests/Utils/make_synthetic_wrfinput.py.  The same inputs file is used for the
# urban run and the rural control; the two differ only in SF_URBAN_PHYSICS in
# namelist.erf.  See README.md.
#
# No wrfbdy is generated, so `erf.nc_bdy_file` is deliberately absent -- with no
# boundary file ERF sets use_real_bcs = false (ERF_DataStruct.H) and periodic
# lateral boundaries are then legal.
# ---------------------------------------------------------------------------
erf.prob_name = "SLUCM_Smoke"

# 1800 s of model time at dt = 1 s, i.e. six Noah-MP firings at
# NOAH_TIMESTEP = 300.
max_step = 1800

# amrex.fpe_trap_invalid is deliberately NOT set. Noah-MP writes its land
# output through NF90_NETCDF4 | NF90_MPIIO, so HDF5 always initialises, and
# H5T__init_native_float_types raises FE_INVALID while probing the native float
# types. That trips the trap during library init, long before any ERF
# arithmetic runs. check_smoke.py asserts finiteness on every land field
# instead, which is the property the trap was standing in for.

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY -- must match the synthetic wrfinput exactly.
geometry.prob_extent = 10000.  10000.  2000.
amr.n_cell           = 10      10      20

geometry.is_periodic = 1 1 0

zlo.type = "Surface_Layer"
zhi.type = "SlipWall"

# TIME STEP CONTROL
erf.fixed_dt = 1.0

# DIAGNOSTICS & VERBOSITY
erf.sum_interval = 300
erf.v            = 1
amr.v            = 1

# REFINEMENT / REGRIDDING
amr.max_level = 0

# CHECKPOINT FILES
erf.check_file = chk
erf.check_int  = -1

# PLOTFILES
# The 3-D plotfile cadence also drives the Noah-MP land NetCDF output
# (lnd<step>/Level_0.nc): ERF's time loop calls LandSurface::Plot whenever it
# writes the plot_int_1 3-D plotfile.  That land file is what check_smoke.py
# reads, so plot_int_1 is what controls how many land samples the test gets.
erf.plot_file_1 = plt
erf.plot_int_1  = 300
erf.plot_vars_1 = density x_velocity y_velocity z_velocity temp theta pressure qv qc

# 2-D diagnostics, written as NetCDF so the checker can read them without an
# AMReX plotfile reader.  urb_frac is here to confirm FRC_URB2D was read.
erf.plotfile2d_type_1 = netcdf
erf.plot2d_file_1     = plt2d
erf.plot2d_int_1      = 300
erf.plot2d_vars_1     = urb_frac landmask t_surf u_star z0 albedo grdflx sensible_heat_flux latent_heat_flux sw_flux_dn lw_flux_dn t_sfc sfc_emis

# SOLVER CHOICE
erf.alpha_T = 0.0
erf.alpha_C = 0.0
erf.use_gravity = true

erf.terrain_type = StaticFittedMesh

erf.land_surface_model = "NOAHMP"
erf.coupling_type      = "OneWay"

# init_type = WRFInput rejects moisture_type = None.
erf.moisture_model = "Kessler"

erf.les_type          = "None"
erf.molec_diff_type   = "Constant"
erf.dynamic_viscosity = 5.0

erf.use_coriolis = false

# RADIATION
# Noah-MP is fed SWDOWN/GLW out of LsmData, which only a radiation model fills;
# with erf.radiation_model = "None" they stay at the lsm_undefined sentinel and
# the Noah-MP shortwave budget check aborts.  RRTMGP is therefore required, not
# optional, for this case.  The four coefficient files ship in
# Submodules/RRTMGP (rrtmgp/data and extensions/cloud_optics); run_smoke.sh
# symlinks them into the run directory.
erf.radiation_model        = "RRTMGP"
# Required unconditionally: Radiation::Radiation does pp.get("rad_t_sfc"), not
# pp.query, so the run aborts at construction without it even though an LSM is
# active and immediately overwrites it. (Docs/sphinx_doc/Inputs.rst says
# "Must be set without LSM", and Exec/RegTests/WPS_Test/inputs_wps_noahmp omits
# it, so that case aborts at startup too.)
erf.rad_t_sfc              = 300.0
erf.rad_freq_in_steps      = 100
erf.rad_do_subcol_sampling = true
erf.rad_write_fluxes       = false
erf.co2vmr                 = 0.00036
erf.o3vmr                  = 3.0e-8
erf.n2ovmr                 = 3.2e-7
erf.covmr                  = 1.5e-7
erf.ch4vmr                 = 1.7e-6
erf.o2vmr                  = 0.209
erf.n2vmr                  = 0.7906
erf.nswbands               = 14
erf.nlwbands               = 16
erf.nswgpts                = 224
erf.nlwgpts                = 256
erf.rrtmgp_file_path       = .
erf.rrtmgp_coeffs_sw       = rrtmgp-data-sw-g224-2018-12-04.nc
erf.rrtmgp_coeffs_lw       = rrtmgp-data-lw-g256-2018-12-04.nc
erf.rrtmgp_cloud_optics_sw = rrtmgp-cloud-optics-coeffs-sw.nc
erf.rrtmgp_cloud_optics_lw = rrtmgp-cloud-optics-coeffs-lw.nc

# INITIALIZATION
erf.real_width     = 0
erf.init_type      = "WRFInput"
erf.nc_init_file_0 = "wrfinput_urban_d01"
